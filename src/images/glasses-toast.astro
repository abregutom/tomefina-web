<style>
  .glass-toast-fade {
    opacity: 0;
    animation: toastWrapFadeIn 0.9s cubic-bezier(0.25, 0.1, 0.25, 1) forwards;
  }

  .glass-frame {
    display: block;
  }

  .glass-before {
    animation: beforeCycle 6s ease-in-out infinite;
  }

  .glass-after {
    transform-origin: 50% 70%;
    animation:
      afterCycle 6s ease-in-out infinite,
      clinkBump 6s ease-in-out infinite;
  }

  @keyframes toastWrapFadeIn {
    0% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }

  @keyframes beforeCycle {
    0%,
    36% {
      opacity: 1;
    }
    50%,
    92% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }

  @keyframes afterCycle {
    0%,
    36% {
      opacity: 0;
    }
    50%,
    92% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes clinkBump {
    0%,
    46% {
      transform: scale(1) rotate(0deg);
    }
    50% {
      transform: scale(1.05) rotate(-1deg);
    }
    56% {
      transform: scale(0.99) rotate(0.5deg);
    }
    62%,
    100% {
      transform: scale(1) rotate(0deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glass-toast-fade {
      opacity: 1;
      animation: none;
    }
    .glass-before {
      animation: none;
      opacity: 0;
    }
    .glass-after {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
