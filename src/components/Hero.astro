---
import HeroFrame from './HeroFrame.astro';
---

<section id="hero" class="bg-[#FFE7EF] px-4 relative overflow-hidden min-h-dvh md:min-h-0 flex items-center justify-center py-10 md:py-20 xl:py-24">
  <div class="w-full max-w-[1320px] mx-auto">
    <HeroFrame>
      <div class="flex flex-col md:flex-row items-center gap-6 md:gap-6 px-6 py-8 md:px-10 md:py-8 xl:py-10">
        <h1 class="md:hidden font-[family-name:var(--font-limoncello)] text-[clamp(19px,8.2vw,33px)] whitespace-nowrap text-[#EE563F] leading-[1.02em]">
          Tomefina dice que sí
        </h1>

        <div class="flex-1 flex justify-center md:justify-start relative min-w-0">
          <img src="/images/pareja-mirador.svg" alt="Decoración" class="w-auto h-auto max-w-full max-h-[220px] sm:max-h-[260px] md:max-h-[300px] xl:max-h-[430px]" />

          <div class="drone-animation absolute inset-0 pointer-events-none">
            <img src="/images/screenshot2.png" alt="Dron" class="drone drone-1" />
            <img src="/images/screenshot2.png" alt="Dron" class="drone drone-2" />
            <img src="/images/screenshot2.png" alt="Dron" class="drone drone-3" />
          </div>
        </div>

        <div class="flex-1 text-center">
          <h1 class="hidden md:block font-[family-name:var(--font-limoncello)] text-[clamp(26px,3vw,31px)] xl:text-[50px] whitespace-nowrap text-[#EE563F] leading-[1.02em] mb-4">
            Tomefina dice que sí
          </h1>

          <p class="font-[family-name:var(--font-didot)] text-[clamp(24px,2.8vw,30px)] xl:text-[48px] whitespace-nowrap text-[#EE563F] leading-[1.02em] tracking-[0.04em] lowercase mb-4">
            19 · 12 · 2026
          </p>

          <div class="flex flex-col gap-2 mb-8">
            <p class="font-[family-name:var(--font-montserrat)] text-[#EE563F] text-lg md:text-[28px] tracking-[0.04em] uppercase whitespace-nowrap">
              18:30 hs
            </p>
            <p class="font-[family-name:var(--font-montserrat)] text-[#EE563F] text-lg md:text-[28px] tracking-[0.04em] whitespace-nowrap">
              Finca Madero El Roble
            </p>
          </div>

          <div class="flex flex-col md:flex-row items-center justify-center gap-4 md:gap-8 mb-8">
            <a
              href="https://maps.app.goo.gl/cmaKWDkdTBt7E7iF8"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block border border-[#EE563F] px-8 py-4 font-[family-name:var(--font-montserrat)] text-[#EE563F] text-lg md:text-xl tracking-[0.04em] uppercase whitespace-nowrap hover:bg-[#EE563F] hover:text-white transition-colors"
            >
              Cómo llegar
            </a>
          </div>
        </div>
      </div>
    </HeroFrame>
  </div>
</section>

<style>
  .drone {
    position: absolute;
    width: 20px;
    height: 20px;
    opacity: 0;
  }

  @media (min-width: 768px) {
    .drone {
      width: 34px;
      height: 34px;
    }
  }

  .drone-1 {
    top: 5%;
    left: 25%;
    animation: droneCycle 6s ease-in-out infinite;
  }

  .drone-2 {
    top: 5%;
    right: 10%;
    animation: droneCycle 6s ease-in-out infinite 2s;
  }

  .drone-3 {
    bottom: 25%;
    right: 10%;
    animation: droneCycle 6s ease-in-out infinite 4s;
  }

  @keyframes droneCycle {
    0%, 100% {
      opacity: 0;
      transform: translateY(0);
    }
    15% {
      opacity: 1;
      transform: translateY(-5px);
    }
    35% {
      opacity: 1;
      transform: translateY(5px);
    }
    50%, 100% {
      opacity: 0;
      transform: translateY(0);
    }
  }
</style>
