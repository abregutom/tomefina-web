---
---

<section id="hero" class="bg-[#FFE7EF] py-16 md:py-24 px-4 relative overflow-hidden">
  <div class="max-w-[1080px] mx-auto flex flex-col md:flex-row items-center gap-8">
    <div class="flex-1 flex justify-center relative">
      <img src="/images/grupo-illustration.svg" alt="Decoración" class="w-full max-w-[558px]" />

      <div class="drone-animation absolute inset-0 pointer-events-none">
        <img src="/images/screenshot2.png" alt="Dron" class="drone drone-1" />
        <img src="/images/screenshot2.png" alt="Dron" class="drone drone-2" />
        <img src="/images/screenshot2.png" alt="Dron" class="drone drone-3" />
      </div>
    </div>

    <div class="flex-1 text-center md:text-left">
      <h1 class="font-[family-name:var(--font-limoncello)] text-[#EE563F] text-4xl md:text-[65px] leading-[1.02em] mb-6 whitespace-nowrap">
        Tomefina dice que sí
      </h1>

      <p class="font-[family-name:var(--font-didot)] text-[#EE563F] text-4xl md:text-[65px] leading-[1.02em] tracking-[0.04em] lowercase mb-6">
        19 · 12 · 2026
      </p>

      <div class="flex flex-col gap-2 mb-8">
        <p class="font-[family-name:var(--font-montserrat)] text-[#EE563F] text-lg md:text-[28px] tracking-[0.04em] uppercase">
          18:30 hs
        </p>
        <p class="font-[family-name:var(--font-montserrat)] text-[#EE563F] text-lg md:text-[28px] tracking-[0.04em]">
          Finca Madero El Roble
        </p>
      </div>

      <div class="flex flex-col md:flex-row items-center gap-4 md:gap-8 mb-8">
        <a
          href="https://maps.app.goo.gl/cmaKWDkdTBt7E7iF8"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block border border-[#EE563F] px-8 py-4 font-[family-name:var(--font-montserrat)] text-[#EE563F] text-lg md:text-xl tracking-[0.04em] uppercase hover:bg-[#EE563F] hover:text-white transition-colors"
        >
          Cómo llegar
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .drone {
    position: absolute;
    width: 30px;
    height: 30px;
    opacity: 0;
  }

  @media (min-width: 768px) {
    .drone {
      width: 50px;
      height: 50px;
    }
  }

  .drone-1 {
    top: 5%;
    left: 25%;
    animation: droneCycle 6s ease-in-out infinite;
  }

  .drone-2 {
    top: 5%;
    right: 10%;
    animation: droneCycle 6s ease-in-out infinite 2s;
  }

  .drone-3 {
    bottom: 25%;
    right: 10%;
    animation: droneCycle 6s ease-in-out infinite 4s;
  }

  @keyframes droneCycle {
    0%, 100% {
      opacity: 0;
      transform: translateY(0);
    }
    15% {
      opacity: 1;
      transform: translateY(-5px);
    }
    35% {
      opacity: 1;
      transform: translateY(5px);
    }
    50%, 100% {
      opacity: 0;
      transform: translateY(0);
    }
  }
</style>
