---

<section id="novios" class="bg-[#FFE3CC] py-16 md:py-24 px-4 relative overflow-hidden">
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center gap-8">
    <div class="flex-1 flex justify-center">
      <img src="/images/celebration-illustration.svg" alt="Celebración" class="w-full max-w-[533px]" />
    </div>

    <div class="flex-1 text-center md:text-left">
      <h2 class="font-[family-name:var(--font-limoncello)] text-[#EE7E23] text-4xl md:text-[70px] leading-[1.02em] mb-4">
        13 años de novios
      </h2>

      <div class="mb-6">
        <img src="/images/linea-decorativa2.svg" alt="" class="w-full max-w-[514px] mx-auto md:mx-0" aria-hidden="true" />
      </div>

      <h3 class="font-[family-name:var(--font-didot)] text-[#EE7E23] text-3xl md:text-[45px] leading-[1.02em] tracking-[0.04em] uppercase mb-8">
        Juntamos muchas<br />
        ganas de festejar
      </h3>

      <p class="font-[family-name:var(--font-limoncello)] text-[#EE7E23] text-4xl md:text-[45px] leading-none">
        ¿Estás a la altura?
      </p>
    </div>
  </div>
</section>
