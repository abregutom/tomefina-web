---
import GlassesToast from '../images/glasses-toast.astro';

// Google Apps Script Web App URL that appends submissions to a Google Sheet.
// See instructions given to set this up; paste the deployed /exec URL here.
const RSVP_ENDPOINT = 'https://script.google.com/macros/s/AKfycbzZLSodUl4E8ssymQjth_lRlmijEJ4T_d78-P2PpsJhYmGhFc1wk4_P9X1KsHfyQWLkxg/exec';

const dietas = [
  'Como todo',
  'Vegetariano',
  'Vegano',
  'Celíaco',
  'Intolerante a la lactosa',
];
---

<section id="rsvp" class="bg-[#F5F3C2] py-16 md:py-24 px-4 relative">
  <!-- Mobile layout -->
  <div class="md:hidden max-w-md mx-auto text-center">
    <h2 class="font-[family-name:var(--font-limoncello)] text-[#706B2E] text-[clamp(32px,10.5vw,48px)] leading-[1.02em] mb-6">
      No pongamos en<br />
      riesgo la noche
    </h2>

    <svg class="w-full max-w-[300px] h-auto mx-auto mb-6" viewBox="0 0 400 8" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M4.4371 4.47747L-5.70509e-05 4.58412C1.91523 4.13176 3.72792 3.95089 5.92238 3.83403C22.7089 2.93693 39.1064 3.28451 56.0469 3.80923L102.813 5.25774C122.454 5.86739 141.177 4.29574 160.359 1.75816C174.081 -0.0568786 187.323 -0.472157 201.203 0.538591C216.454 1.65004 231.044 1.92805 246.448 1.43821C264.756 0.853668 282.359 0.67732 300.768 1.12297C333.971 1.92806 366.524 3.01798 400 5.11453C395.551 6.36409 390.927 5.22875 386.183 5.53957L336.163 3.65965C306.585 2.54924 277.64 2.36039 248.075 3.56759C231.977 4.22579 216.698 3.96091 200.823 2.72512C186.739 1.62943 173.315 2.15028 159.388 3.98972C140.9 6.43656 122.795 7.95971 103.897 7.26644L67.3219 5.92397C51.3657 5.33714 35.9857 4.25019 20.0236 4.08313C14.7261 4.0263 9.64872 4.34722 4.4371 4.47394L4.4371 4.47747Z" fill="#706B2E" />
    </svg>

    <div class="w-full max-w-[260px] mx-auto mb-6">
      <GlassesToast />
    </div>

    <p class="font-[family-name:var(--font-montserrat)] text-[#706B2E] text-[clamp(13px,3.8vw,18px)] tracking-[0.04em] uppercase mb-8">
      Rellená el formulario con<br />
      tus datos y restricciones
    </p>

    <button
      type="button"
      id="rsvp-open-form-mobile"
      class="rsvp-open-form-btn inline-block border border-[#706B2E] px-8 py-4 font-[family-name:var(--font-montserrat)] text-[#706B2E] text-lg tracking-[0.04em] uppercase hover:bg-[#706B2E] hover:text-[#F5F3C2] transition-colors"
    >
      completar form
    </button>
  </div>

  <!-- Desktop layout -->
  <div class="hidden md:flex max-w-6xl mx-auto items-center gap-8">
    <div class="flex-1 flex justify-center w-full">
      <div class="w-full max-w-[320px]">
        <GlassesToast />
      </div>
    </div>

    <svg class="w-[220px] h-auto shrink-0 rotate-90" viewBox="0 0 400 8" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M4.4371 4.47747L-5.70509e-05 4.58412C1.91523 4.13176 3.72792 3.95089 5.92238 3.83403C22.7089 2.93693 39.1064 3.28451 56.0469 3.80923L102.813 5.25774C122.454 5.86739 141.177 4.29574 160.359 1.75816C174.081 -0.0568786 187.323 -0.472157 201.203 0.538591C216.454 1.65004 231.044 1.92805 246.448 1.43821C264.756 0.853668 282.359 0.67732 300.768 1.12297C333.971 1.92806 366.524 3.01798 400 5.11453C395.551 6.36409 390.927 5.22875 386.183 5.53957L336.163 3.65965C306.585 2.54924 277.64 2.36039 248.075 3.56759C231.977 4.22579 216.698 3.96091 200.823 2.72512C186.739 1.62943 173.315 2.15028 159.388 3.98972C140.9 6.43656 122.795 7.95971 103.897 7.26644L67.3219 5.92397C51.3657 5.33714 35.9857 4.25019 20.0236 4.08313C14.7261 4.0263 9.64872 4.34722 4.4371 4.47394L4.4371 4.47747Z" fill="#706B2E" />
    </svg>

    <div class="flex-1 text-left">
      <h2 class="font-[family-name:var(--font-limoncello)] text-[#706B2E] text-[60px] leading-[1.02em] mb-8">
        No pongamos en<br />
        riesgo la noche
      </h2>

      <p class="font-[family-name:var(--font-montserrat)] text-[#706B2E] text-[22px] tracking-[0.04em] uppercase mb-8">
        Rellená el formulario con<br />
        tus datos y restricciones
      </p>

      <button
        type="button"
        id="rsvp-open-form-desktop"
        class="rsvp-open-form-btn inline-block border border-[#706B2E] px-8 py-4 font-[family-name:var(--font-montserrat)] text-[#706B2E] text-[22px] tracking-[0.04em] uppercase hover:bg-[#706B2E] hover:text-[#F5F3C2] transition-colors"
      >
        completar form
      </button>
    </div>
  </div>
</section>

<dialog
  id="rsvp-form-dialog"
  class="m-auto max-w-2xl w-[calc(100%-2rem)] p-0 bg-transparent backdrop:bg-[#706B2E]/60"
>
  <div class="relative bg-[#FDFDF3] border border-[#706B2E]/40 p-5 md:p-8 max-h-[90vh] overflow-y-auto w-full">
    <button
      type="button"
      id="rsvp-close-form"
      aria-label="Cerrar"
      class="absolute top-3 right-3 font-[family-name:var(--font-montserrat)] text-[#706B2E] text-2xl leading-none hover:opacity-60 transition-opacity"
    >
      &times;
    </button>

    <form id="rsvp-form-el" data-endpoint={RSVP_ENDPOINT} novalidate>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
        <div>
          <label
            for="rsvp-nombre"
            class="block font-[family-name:var(--font-montserrat)] text-[#706B2E] text-sm tracking-[0.04em] uppercase mb-1"
          >
            Nombre
          </label>
          <input
            type="text"
            id="rsvp-nombre"
            name="nombre"
            required
            class="w-full bg-transparent border-0 border-b border-[#706B2E]/50 focus:border-[#706B2E] outline-none py-1.5 font-[family-name:var(--font-montserrat)] text-[#706B2E] text-base placeholder:text-[#706B2E]/40 transition-colors"
          />
        </div>

        <div>
          <label
            for="rsvp-apellido"
            class="block font-[family-name:var(--font-montserrat)] text-[#706B2E] text-sm tracking-[0.04em] uppercase mb-1"
          >
            Apellido
          </label>
          <input
            type="text"
            id="rsvp-apellido"
            name="apellido"
            required
            class="w-full bg-transparent border-0 border-b border-[#706B2E]/50 focus:border-[#706B2E] outline-none py-1.5 font-[family-name:var(--font-montserrat)] text-[#706B2E] text-base placeholder:text-[#706B2E]/40 transition-colors"
          />
        </div>
      </div>

      <div class="mb-4">
        <span class="block font-[family-name:var(--font-montserrat)] text-[#706B2E] text-sm tracking-[0.04em] uppercase mb-2">
          Dieta (marcá todas las que apliquen)
        </span>
        <div class="flex flex-wrap gap-x-5 gap-y-2">
          {dietas.map((dieta) => (
            <label class="flex items-center gap-2 font-[family-name:var(--font-montserrat)] text-[#706B2E] text-sm cursor-pointer">
              <input
                type="checkbox"
                name="dieta"
                value={dieta}
                class="w-4 h-4 accent-[#706B2E] border-[#706B2E]"
              />
              {dieta}
            </label>
          ))}
        </div>
      </div>

      <div class="mb-5">
        <label
          for="rsvp-otra-alergia"
          class="block font-[family-name:var(--font-montserrat)] text-[#706B2E] text-sm tracking-[0.04em] uppercase mb-1"
        >
          Otra alergia a tener en cuenta (opcional)
        </label>
        <input
          type="text"
          id="rsvp-otra-alergia"
          name="otraAlergia"
          class="w-full bg-transparent border-0 border-b border-[#706B2E]/50 focus:border-[#706B2E] outline-none py-1.5 font-[family-name:var(--font-montserrat)] text-[#706B2E] text-base placeholder:text-[#706B2E]/40 transition-colors"
        />
      </div>

      <button
        type="submit"
        class="w-full border border-[#706B2E] px-8 py-3 font-[family-name:var(--font-montserrat)] text-[#706B2E] text-lg tracking-[0.04em] uppercase hover:bg-[#706B2E] hover:text-[#F5F3C2] transition-colors disabled:opacity-50"
      >
        Enviar
      </button>

      <p
        id="rsvp-form-message"
        role="status"
        class="mt-3 text-center font-[family-name:var(--font-montserrat)] text-[#706B2E] text-sm tracking-[0.04em]"
      ></p>
    </form>

    <div id="rsvp-thanks" role="status" class="hidden text-center py-8">
      <p class="font-[family-name:var(--font-limoncello)] text-[#706B2E] text-3xl mb-3">
        ¡Gracias!
      </p>
      <p class="font-[family-name:var(--font-montserrat)] text-[#706B2E] text-sm tracking-[0.04em] uppercase">
        Ya recibimos tu respuesta.<br />
      </p>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('rsvp-form-dialog') as HTMLDialogElement | null;
  const openButtons = document.querySelectorAll('.rsvp-open-form-btn');
  const closeButton = document.getElementById('rsvp-close-form');
  const form = document.getElementById('rsvp-form-el') as HTMLFormElement | null;
  const message = document.getElementById('rsvp-form-message');
  const submitButton = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;
  const thanksPanel = document.getElementById('rsvp-thanks');

  function resetFormState() {
    submitButton?.removeAttribute('disabled');
    if (message) message.textContent = '';
    form?.reset();
    form?.classList.remove('hidden');
    thanksPanel?.classList.add('hidden');
  }

  openButtons.forEach((btn) => btn.addEventListener('click', () => dialog?.showModal()));
  closeButton?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  dialog?.addEventListener('close', resetFormState);

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !message) return;

    const endpoint = form.dataset.endpoint;

    if (!endpoint || endpoint.startsWith('REPLACE_WITH_')) {
      message.textContent = 'El formulario todavía no está conectado. Avisá a Tom y Fina.';
      return;
    }

    const formData = new FormData(form);
    const payload = {
      nombre: formData.get('nombre'),
      apellido: formData.get('apellido'),
      dieta: formData.getAll('dieta'),
      otraAlergia: formData.get('otraAlergia') || '',
    };

    submitButton?.setAttribute('disabled', 'true');
    message.textContent = 'Enviando...';

    const showSuccess = () => {
      form.reset();
      message.textContent = '';
      form.classList.add('hidden');
      thanksPanel?.classList.remove('hidden');
    };

    const showError = () => {
      message.textContent = 'Hubo un error al enviar. Probá de nuevo en un rato.';
      submitButton?.removeAttribute('disabled');
    };

    // Google Apps Script responds via a redirect that some mobile browsers mishandle
    // under fetch's no-cors mode, throwing even though doPost already completed server-side.
    // sendBeacon is fire-and-forget by design (no response to mishandle) and avoids this.
    if (navigator.sendBeacon) {
      const body = new Blob([JSON.stringify(payload)], { type: 'text/plain;charset=utf-8' });
      if (navigator.sendBeacon(endpoint, body)) {
        showSuccess();
        return;
      }
    }

    try {
      await fetch(endpoint, {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify(payload),
      });

      showSuccess();
    } catch (err) {
      showError();
    }
  });
</script>
