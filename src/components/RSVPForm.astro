---
---

<section id="rsvp" class="bg-[#F5F3C2] py-16 md:py-24 px-4 relative">
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center gap-8">
    <div class="flex-1 flex justify-center">
      <img src="/images/vasos-brindando.svg" alt="Vasos brindando" class="w-full max-w-[386px]" />
    </div>

    <div class="flex-1 text-center md:text-left">
      <h2 class="font-[family-name:var(--font-limoncello)] text-[#706B2E] text-5xl md:text-[60px] leading-[1.02em] mb-8">
        No pongamos en<br />
        riesgo la noche
      </h2>

      <p class="font-[family-name:var(--font-montserrat)] text-[#706B2E] text-lg md:text-xl tracking-[0.04em] mb-8">
        Rellená el formulario con<br />
        tus datos y restricciones
      </p>

      <a
        href="#rsvp-form"
        class="inline-block border border-[#706B2E] px-8 py-4 font-[family-name:var(--font-montserrat)] text-[#706B2E] text-lg md:text-xl tracking-[0.04em] uppercase hover:bg-[#706B2E] hover:text-[#F5F3C2] transition-colors"
      >
        completar form
      </a>
    </div>
  </div>
</section>
