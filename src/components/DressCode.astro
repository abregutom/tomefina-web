---

<section id="dress-code" class="bg-[#FDFDF3] py-16 md:py-24 px-4 relative">
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center gap-8">
    <div class="flex-1 text-center md:text-left">
      <h2 class="font-[family-name:var(--font-limoncello)] text-[#4B7AC8] text-5xl md:text-[65px] leading-none mb-8">
        Dress Code
      </h2>

      <div class="mb-6">
        <img src="/images/linea-decorativa.svg" alt="" class="w-full max-w-[400px] mx-auto md:mx-0" aria-hidden="true" />
      </div>

      <h3 class="font-[family-name:var(--font-didot)] text-[#4B7AC8] text-2xl md:text-[29px] tracking-[0.04em] uppercase mb-6">
        Elegante. Más es más.
      </h3>

      <p class="font-[family-name:var(--font-montserrat)] text-[#4B7AC8] text-base md:text-lg tracking-[0.04em] max-w-md">
        Chicas no entren en la lista negra:<br />
        blanco, beige, crudo, paliditos no.
      </p>
    </div>

    <div class="flex-1 flex justify-center">
      <img src="/images/pareja-bailando.svg" alt="Pareja bailando" class="w-full max-w-[364px]" />
    </div>
  </div>
</section>
