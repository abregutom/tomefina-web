---

<section id="dress-code" class="bg-[#FDFDF3] py-16 md:py-24 px-4 relative">
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-center gap-8 md:gap-10">
    <div class="text-center">
      <h2 class="font-[family-name:var(--font-limoncello)] text-[#82A8E7] text-5xl md:text-[65px] leading-none mb-2">
        Dress Code
      </h2>

      <h3 class="font-[family-name:var(--font-didot)] text-[#82A8E7] text-2xl md:text-[clamp(22px,3.3vw,29px)] tracking-[0.04em] uppercase mb-6">
        Elegante. Más es más.
      </h3>

      <div class="mb-6">
        <img src="/images/linea-decorativa.svg" alt="" class="w-full max-w-[400px] mx-auto" aria-hidden="true" />
      </div>

      <p class="font-[family-name:var(--font-montserrat)] text-[#82A8E7] text-base md:text-lg tracking-[0.04em] max-w-md mx-auto">
        Chicas no entren en la lista negra:<br />
        blanco, beige, crudo, paliditos no.
      </p>
    </div>

    <div class="flex justify-center">
      <img src="/images/pareja-bailando.svg" alt="Pareja bailando" class="w-full max-w-[364px]" />
    </div>
  </div>
</section>
