---
---

<footer id="footer" class="bg-[#FFE7EF] py-16 md:py-24 px-4 relative">
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center gap-8">
    <div class="flex-1 flex justify-center">
      <img src="/images/grupo-celular.svg" alt="Grupo" class="w-full max-w-[558px]" loading="lazy" decoding="async" />
    </div>

    <div class="flex-1 text-center md:text-left">
      <h2 class="font-[family-name:var(--font-limoncello)] text-[#EE563F] text-5xl md:text-[65px] leading-none mb-6">
        Tomefina dice que sí
      </h2>

      <p class="font-[family-name:var(--font-didot)] text-[#EE563F] text-5xl md:text-[65px] leading-[1.02em] tracking-[0.04em] lowercase mb-6">
        19 · 12 · 2026
      </p>

      <div class="flex flex-col gap-2 mb-8">
        <p class="font-[family-name:var(--font-montserrat)] text-[#EE563F] text-lg md:text-xl tracking-[0.04em] uppercase">
          18:30 hs
        </p>
        <p class="font-[family-name:var(--font-montserrat)] text-[#EE563F] text-lg md:text-xl tracking-[0.04em]">
          FINCA MADERO EL ROBLE
        </p>
      </div>

      <a
        href="https://maps.app.goo.gl/cmaKWDkdTBt7E7iF8"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block border border-[#EE563F] px-8 py-4 font-[family-name:var(--font-montserrat)] text-[#EE563F] text-lg md:text-xl tracking-[0.04em] uppercase hover:bg-[#EE563F] hover:text-white transition-colors"
      >
        Cómo llegar
      </a>
    </div>
  </div>
</footer>
