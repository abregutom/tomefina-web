<section id="instagram" class="bg-[#FDFDF3] py-16 md:py-24 px-4 relative">
  <div class="max-w-[1080px] mx-auto flex flex-col md:flex-row items-center justify-between gap-6 md:gap-4">
    <div class="flex-1 min-w-0 text-center md:text-left">
      <h2 class="font-[family-name:var(--font-didot)] text-[#EE563F] text-[22px] md:text-[26px] lg:text-[35px] whitespace-nowrap leading-[1.02em] uppercase">
        No te pierdas<br />
        la cobertura oficial<br />
        en Instagram
      </h2>
    </div>

    <div class="shrink-0 flex justify-center">
      <img src="/images/celular-corazones.svg" alt="Celular con corazones" class="w-[140px] md:w-[180px] lg:w-[229px]" />
    </div>

    <div class="shrink-0 flex justify-center md:justify-end">
      <a
        href="https://www.instagram.com/tomefina.19.12"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block whitespace-nowrap text-center border border-[#EE563F] px-4 md:px-6 lg:px-8 py-4 font-[family-name:var(--font-montserrat)] text-[#EE563F] text-base md:text-base lg:text-xl tracking-[0.04em] uppercase hover:bg-[#EE563F] hover:text-white transition-colors"
      >
        seguir a tomefina
      </a>
    </div>
  </div>
</section>
