<section id="gifts" class="bg-[#C0D3F3] py-16 md:py-24 px-4 relative">
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center gap-8">
    <div class="flex-1 text-center md:text-left">
      <h2 class="font-[family-name:var(--font-limoncello)] text-[#4B7AC8] text-4xl md:text-[60px] leading-[1.02em] mb-8 whitespace-nowrap">
        ¿Nos querés regalar algo?
      </h2>

      <p class="font-[family-name:var(--font-montserrat)] text-[#4B7AC8] text-base md:text-lg tracking-[0.04em] uppercase mb-6">
        Que esta cuenta se llene de amor<br />
        xxxxxxxxxxxxxxxxx<br />
        alias: tomefina
      </p>

      <p class="font-[family-name:var(--font-montserrat)] text-[#4B7AC8] text-base md:text-lg tracking-[0.04em] uppercase">
        también podés buscar<br />
        el buzón en la fiesta
      </p>
    </div>

    <div class="flex-1 flex justify-center">
      <img src="/images/cuarto-dibujito.svg" alt="Buzón" class="w-full max-w-[349px]" />
    </div>
  </div>
</section>
