<style>
  .gift-heart {
    opacity: 0;
    transform: scale(0.4);
    transition: opacity 0.35s ease-out, transform 0.35s ease-out;
  }

  .gifts-hearts.is-visible .gift-heart {
    opacity: 1;
    transform: scale(1);
  }

  .gifts-hearts.is-visible .gift-heart:nth-child(1) { transition-delay: 0ms; }
  .gifts-hearts.is-visible .gift-heart:nth-child(2) { transition-delay: 100ms; }
  .gifts-hearts.is-visible .gift-heart:nth-child(3) { transition-delay: 200ms; }
  .gifts-hearts.is-visible .gift-heart:nth-child(4) { transition-delay: 300ms; }
  .gifts-hearts.is-visible .gift-heart:nth-child(5) { transition-delay: 400ms; }
  .gifts-hearts.is-visible .gift-heart:nth-child(6) { transition-delay: 500ms; }
  .gifts-hearts.is-visible .gift-heart:nth-child(7) { transition-delay: 600ms; }

  @media (prefers-reduced-motion: reduce) {
    .gift-heart {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const heartsContainer = document.querySelector<HTMLElement>('.gifts-hearts');

  if (heartsContainer) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.4 }
    );

    observer.observe(heartsContainer);
  }
</script>
