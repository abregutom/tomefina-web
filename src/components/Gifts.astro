---
---

<section id="gifts" class="bg-[#C0D3F3] py-16 md:py-24 px-4 relative">
  <!-- Mobile layout -->
  <div class="md:hidden max-w-md mx-auto">
    <h2 class="font-[family-name:var(--font-limoncello)] text-[#4B7AC8] text-[clamp(28px,9vw,40px)] leading-[1.02em] text-center mb-6">
      ¿Nos querés regalar algo?
    </h2>

    <div class="grid grid-cols-2 gap-4 items-start mb-6">
      <div class="relative h-20" aria-hidden="true">
        <svg class="absolute top-1 left-2 w-4 h-4 text-[#4B7AC8] rotate-[-10deg]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
        <svg class="absolute top-6 left-8 w-5 h-5 text-[#4B7AC8] rotate-[8deg]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
        <svg class="absolute top-0 left-16 w-3.5 h-3.5 text-[#4B7AC8] rotate-[15deg]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
        <svg class="absolute top-11 left-1 w-4 h-4 text-[#4B7AC8] rotate-[20deg]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
      </div>

      <p class="font-[family-name:var(--font-montserrat)] text-[#4B7AC8] text-sm tracking-[0.04em] uppercase text-right">
        Que esta cuenta se llene de amor<br />
        <span class="break-all">xxxxxxxxxxxxxxxxx</span><br />
        <span class="break-all">yyyyyyyyyyyyyyyyy</span><br />
        alias: tomefina
      </p>
    </div>

    <svg class="w-full h-2 mb-6" viewBox="0 0 400 8" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M4.4371 4.47747L-5.70509e-05 4.58412C1.91523 4.13176 3.72792 3.95089 5.92238 3.83403C22.7089 2.93693 39.1064 3.28451 56.0469 3.80923L102.813 5.25774C122.454 5.86739 141.177 4.29574 160.359 1.75816C174.081 -0.0568786 187.323 -0.472157 201.203 0.538591C216.454 1.65004 231.044 1.92805 246.448 1.43821C264.756 0.853668 282.359 0.67732 300.768 1.12297C333.971 1.92806 366.524 3.01798 400 5.11453C395.551 6.36409 390.927 5.22875 386.183 5.53957L336.163 3.65965C306.585 2.54924 277.64 2.36039 248.075 3.56759C231.977 4.22579 216.698 3.96091 200.823 2.72512C186.739 1.62943 173.315 2.15028 159.388 3.98972C140.9 6.43656 122.795 7.95971 103.897 7.26644L67.3219 5.92397C51.3657 5.33714 35.9857 4.25019 20.0236 4.08313C14.7261 4.0263 9.64872 4.34722 4.4371 4.47394L4.4371 4.47747Z" fill="#4B7AC8" />
    </svg>

    <div class="grid grid-cols-2 gap-4 items-end">
      <p class="font-[family-name:var(--font-montserrat)] text-[#4B7AC8] text-sm tracking-[0.04em] uppercase">
        también podés buscar<br />
        el buzón en la fiesta
      </p>

      <img src="/images/cuarto-dibujito.svg" alt="Buzón" class="w-full max-w-[160px] justify-self-end" />
    </div>
  </div>

  <!-- Desktop layout -->
  <div class="hidden md:flex max-w-6xl mx-auto items-center gap-8">
    <div class="flex-1 text-left">
      <h2 class="font-[family-name:var(--font-limoncello)] text-[#4B7AC8] text-[clamp(22px,4.4vw,60px)] whitespace-nowrap leading-[1.02em] mb-8">
        ¿Nos querés regalar algo?
      </h2>

      <p class="font-[family-name:var(--font-montserrat)] text-[#4B7AC8] text-lg tracking-[0.04em] uppercase mb-6">
        Que esta cuenta se llene de amor<br />
        <span class="break-all">xxxxxxxxxxxxxxxxx</span><br />
        <span class="break-all">yyyyyyyyyyyyyyyyy</span><br />
        alias: tomefina
      </p>

      <p class="font-[family-name:var(--font-montserrat)] text-[#4B7AC8] text-lg tracking-[0.04em] uppercase">
        también podés buscar<br />
        el buzón en la fiesta
      </p>
    </div>

    <div class="flex-1 flex justify-center">
      <img src="/images/cuarto-dibujito.svg" alt="Buzón" class="w-full max-w-[349px]" />
    </div>
  </div>
</section>
